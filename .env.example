VITE_API_BASE_URL=https://api.iprs.choira.io

# Razorpay Key ID only - this is the public identifier and is safe on the
# frontend. Never add a Key Secret here or anywhere in this repo: it must
# only ever live in the backend's environment, used for order creation and
# payment signature verification. See https://razorpay.com/docs/payments/server-integration/
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here
